APP_ENV=production
DATABASE_URL=postgresql+asyncpg://user:password@database-host:5432/defectsync?sslmode=verify-full
DATABASE_URL_SYNC=postgresql+psycopg://user:password@database-host:5432/defectsync?sslmode=verify-full
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGINS=https://inspection.example.com
CAMERA_ALLOWED_HOSTS=192.168.10.21,192.168.10.22
ML_DEVICE=cpu
ML_MODEL_PATH=ml/models/defect_detector.pt
ML_CONFIDENCE_THRESHOLD=0.25
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=/data/uploads
STREAM_TIMEOUT_SECONDS=10
STREAM_MAX_SECONDS=120
