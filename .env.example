# Database
DATABASE_URL=postgresql+asyncpg://defectsync:defectsync_dev@localhost:5432/defectsync
DATABASE_URL_SYNC=postgresql+psycopg://defectsync:defectsync_dev@localhost:5432/defectsync

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_IMAGES=images
S3_BUCKET_IFC=ifc-models
S3_BUCKET_FRAGMENTS=fragments
S3_BUCKET_REPORTS=reports

# JWT Auth
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ML
ML_MODEL_PATH=ml/models/defect_detector.pt
ML_CONFIDENCE_THRESHOLD=0.25
ML_DEVICE=cpu

# App
APP_NAME=DefectSync
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
