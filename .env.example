# ============================================================
# DefectSync — Environment Configuration
# ============================================================
# Copy this to .env and fill in your values.
# No Docker/WSL required — uses cloud-hosted services.
# ============================================================

# ---- DATABASE (Neon — free serverless Postgres) ----
# Sign up at https://neon.tech, create a project, and copy the connection string.
# Neon gives you a pooled connection string like:
#   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
#
# For asyncpg (used by FastAPI), replace postgresql:// with postgresql+asyncpg://
# For psycopg (used by Alembic), replace postgresql:// with postgresql+psycopg://
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/defectsync?sslmode=require
DATABASE_URL_SYNC=postgresql+psycopg://user:pass@ep-xxx.us-east-2.aws.neon.tech/defectsync?sslmode=require

# ---- REDIS (Upstash — free serverless Redis) ----
# Sign up at https://upstash.com, create a Redis database, and copy the connection URL.
# Upstash gives you: rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=rediss://default:your-password@your-endpoint.upstash.io:6379

# ---- FILE STORAGE ----
# For development: uses local filesystem (no S3/MinIO needed).
# Set STORAGE_BACKEND=local to store files in backend/uploads/
# Set STORAGE_BACKEND=s3 to use S3-compatible storage (MinIO, AWS S3, Cloudflare R2)
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads

# S3 settings (only needed if STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_IMAGES=images
S3_BUCKET_IFC=ifc-models
S3_BUCKET_FRAGMENTS=fragments
S3_BUCKET_REPORTS=reports

# ---- JWT AUTH ----
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- ML MODEL ----
ML_MODEL_PATH=ml/models/defect_detector.pt
ML_CONFIDENCE_THRESHOLD=0.25
ML_DEVICE=cpu

# ---- APP ----
APP_NAME=DefectSync
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
